{
  "engine": "gravityforms",
  "wpFormId": 24,
  "title": "US Company registration",
  "description": "",
  "page": "/us-company-registration/",
  "pageTitle": "US Company registration",
  "multiPage": false,
  "submitLabel": "Submit",
  "fields": [
    {
      "id": "1",
      "type": "section",
      "label": "COMPANY INFORMATION",
      "required": false,
      "description": "ORDER INFORMATION"
    },
    {
      "id": "8",
      "type": "radio",
      "label": "What type of business would you like to start?",
      "required": true,
      "description": "LLC is great for small businesses looking to access the US market. C-Corporattion (C-Corp) is great for startups (owned by foreigners) looking to raise funds in the US. S-Corporation (S-Corp) for US citizens only",
      "choices": [
        "LLC",
        "C-Corporation",
        "S-Corporation"
      ]
    },
    {
      "id": "11",
      "type": "radio",
      "label": "Where in the US will you like to register your business",
      "required": true,
      "description": "Delaware is recommended for startups looking to raise funds from investors, while Wyoming is recommended for small business",
      "choices": [
        "Wyoming",
        "Delaware",
        "Other"
      ]
    },
    {
      "id": "17",
      "type": "text",
      "label": "Name of your company (First Choice)",
      "required": true
    },
    {
      "id": "18",
      "type": "text",
      "label": "Name of company (Second Choice)",
      "required": true
    },
    {
      "id": "23",
      "type": "text",
      "label": "Entity ending",
      "required": true,
      "description": "If you're registering as an LLC select either LLC, L.L.C, or Limited Liability Company. If you are registering as a Corporation, select either; Inc/Incorporated/Co/Corp/Corporation",
      "placeholder": "LLC/L.L.C/Limited Liability Company/Inc/Incorporated/Co/Corp/Corporation"
    },
    {
      "id": "34",
      "type": "text",
      "label": "Total number of shares to authorize",
      "required": true,
      "description": "For C-corp only. Choosing a number depends on how big you expect your company to get and how much you think it will be worth. The best investment for a business owner is to choose the highest number of authorized stocks for the lowest filing fee. For C-Corp, the popular recommendation is $10,000,000",
      "placeholder": "100/1,000/10,000"
    },
    {
      "id": "67",
      "type": "text",
      "label": "Value of each share/Share par value",
      "required": true,
      "description": "For C-Corp only. The par value of a share of corporate stock is the minimum amount that share can be sold for. Most small businesses make a par value of $1.",
      "placeholder": "$1/50 cents"
    },
    {
      "id": "21",
      "type": "textarea",
      "label": "Describe the nature of business",
      "required": true,
      "placeholder": "E.g B2B software, Consulting, E-commerce, Healthcare, Marketing, etc"
    },
    {
      "id": "22",
      "type": "checkbox",
      "label": "Would you like to use a generic business purpose?",
      "required": true,
      "description": "Generic business purpose refers to general contracts and services",
      "choices": [
        "Yes",
        "No"
      ]
    },
    {
      "id": "24",
      "type": "checkbox",
      "label": "Will you like to us to provide a physical US address on your behalf?",
      "required": true,
      "description": "Do not attach much importance to this. If you do not have a physical address in the US, You can use a US mailing address instead if you already have one or we could provide one for you.",
      "choices": [
        "Yes",
        "No, I'll use my mailing address"
      ]
    },
    {
      "id": "25",
      "type": "section",
      "label": "Details of Owners",
      "required": false
    },
    {
      "id": "27",
      "type": "radio",
      "label": "Is the owner an individual or company?",
      "required": true,
      "choices": [
        "Yes",
        "No"
      ]
    },
    {
      "id": "29",
      "type": "text",
      "label": "Name",
      "required": true
    },
    {
