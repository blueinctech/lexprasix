      "required": false,
      "description": "Vesting means a point in time when rights and interests arising from legal ownership of a property is acquired by a person. In this case, an employee"
    },
    {
      "id": "42",
      "type": "radio",
      "label": "10. Will the employee be given an equity option in the company?",
      "required": false,
      "choices": [
        "Yes",
        "No"
      ]
    },
    {
      "id": "43",
      "type": "radio",
      "label": "Will the equity vest? ( For more information on vesting click the link below)",
