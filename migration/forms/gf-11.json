      "choices": [
        "Yes",
        "No"
      ]
    },
    {
      "id": "44",
      "type": "text",
      "label": "If Yes, please provide the duration of the vesting schedule. E.g 4yrs (NB; Its usually recommended that vesting period be between 3-5 years.)",
