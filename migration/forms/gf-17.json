    {
      "id": "46",
      "type": "section",
      "label": "Section 5 : DURATION.",
      "required": false
    },
    {
      "id": "45",
      "type": "text",
      "label": "How long is the lease supposed to last?",
      "required": true,
      "description": "NB: (A lease ought to operate for not less than 3 (three) years)."
    },
    {
      "id": "47",
      "type": "section",
      "label": "Section 6 : RENT.",
      "required": false
    },
    {
      "id": "49",
      "type": "text",
      "label": "a. Please state the amount to be paid as rent.",
      "required": true
    },
    {
      "id": "51",
      "type": "select",
      "label": "b. Is the amount to be paid in advance or arrears?",
      "required": true,
      "choices": [
        "Please Select",
        "Advance",
        "Arrears"
      ]
    },
    {
      "id": "52",
      "type": "section",
      "label": "Section 7 : INSURANCE",
      "required": false,
      "description": "If any"
