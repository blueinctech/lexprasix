      "label": "b. Detailed description of demised property.",
      "required": true
    },
    {
      "id": "41",
      "type": "select",
      "label": "c. Is it part or all of the property leased.",
      "required": true,
      "choices": [
        "Yes",
        "No"
      ]
    },
    {
      "id": "42",
      "type": "section",
      "label": "Section 4 : PURPOSE OF LEASE.",
