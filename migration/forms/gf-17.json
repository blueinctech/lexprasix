    {
      "id": "53",
      "type": "text",
      "label": "a. Who is responsible for insuring the property?",
      "required": false
    },
    {
      "id": "55",
      "type": "select",
      "label": "b. Are there any duties or liabilities to be considered in respect of the insurance policy?",
      "required": false,
      "choices": [
        "Please Select",
        "Yes",
        "No"
      ]
    },
    {
      "id": "56",
