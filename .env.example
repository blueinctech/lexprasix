# Copy to .env.local for development. Never commit real values.
# In Vercel, set these per environment (Preview / Production).

# --- Site
NEXT_PUBLIC_SITE_URL=https://lexpraxisng.com
# "production" only on the production deployment; anything else sends noindex.
SITE_ENV=development

# --- Database (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Auth
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used to hash IPs and sign tokens.
AUTH_SECRET=replace-me

# --- Media storage (S3-compatible; Cloudflare R2 by default)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_MEDIA_BUCKET=lexpraxis-media
S3_UPLOADS_BUCKET=lexpraxis-uploads
# Public base URL of the media bucket (custom domain), no trailing slash.
NEXT_PUBLIC_MEDIA_URL=https://media.lexpraxisng.com
# Max upload size in MB for client documents.
UPLOAD_MAX_MB=10

# --- Email (Resend)
RESEND_API_KEY=replace-me
EMAIL_FROM="LexPraxis Solicitors <no-reply@lexpraxisng.com>"
EMAIL_REPLY_TO=info@lexpraxisng.com
# Comma-separated staff recipients for new enquiries (confirm in WordPress form notifications).
EMAIL_STAFF_TO=info@lexpraxisng.com

# --- Cron (Vercel sends this as a Bearer token to /api/cron/*)
CRON_SECRET=replace-me

# --- Tracking defaults (editable later in Admin → Settings)
NEXT_PUBLIC_GTM_ID=GTM-WXSMSFBP
