# Environment variables. Never commit real values.
#  - Local development: copy to .env.local
#  - Production data loads from your machine: copy to .env.prod.local and run the
#    `npm run prod:*` scripts (Next.js does not load this file automatically)
#  - Vercel: set the same names in Project → Settings → Environment Variables

# --- Site
NEXT_PUBLIC_SITE_URL=https://lexpraxisng.com
# "production" only on the live deployment; anything else sends noindex.
SITE_ENV=production

# --- Database (Neon). Pooled URL (host contains "-pooler") for the app,
# direct URL for migrations. Both from Neon → Connect.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth: 48+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Storage (AWS S3). Leave S3_ENDPOINT empty for AWS (set it only for R2 or other S3-compatible stores).
S3_REGION=eu-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public website media (images, PDFs). Must be publicly readable (bucket policy or CloudFront).
S3_MEDIA_BUCKET=lexpraxis-media
# Private client documents from forms. Block ALL public access.
S3_UPLOADS_BUCKET=lexpraxis-uploads
# Public base URL of the media bucket, no trailing slash, e.g.
# https://lexpraxis-media.s3.eu-west-2.amazonaws.com or a CloudFront/custom domain.
NEXT_PUBLIC_MEDIA_URL=https://lexpraxis-media.s3.eu-west-2.amazonaws.com
# Max upload size in MB for client documents.
UPLOAD_MAX_MB=10

# --- Email (Amazon SES). Uses the S3 access key above by default: give that IAM
# user ses:SendEmail/ses:SendRawEmail too. Set these only to use a different key or region.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional: SES configuration set for bounce/complaint tracking.
SES_CONFIGURATION_SET=
# Sender must be on a verified SES identity (verify the domain lexpraxisng.com).
EMAIL_FROM="LexPraxis Solicitors <no-reply@lexpraxisng.com>"
EMAIL_REPLY_TO=info@lexpraxisng.com
# Comma-separated staff recipients for new enquiries.
EMAIL_STAFF_TO=info@lexpraxisng.com
# Alternative provider: set RESEND_API_KEY instead of the SES_* variables.
RESEND_API_KEY=

# --- Cron (Vercel sends this as a Bearer token to /api/cron/*)
CRON_SECRET=

# --- Retention: delete completed/archived enquiries after N days (0 = keep). Spam is always purged after 30 days.
ENQUIRY_RETENTION_DAYS=0
